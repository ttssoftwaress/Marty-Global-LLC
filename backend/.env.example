NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://marty:marty@localhost:5433/marty
REDIS_URL=redis://localhost:6379

# Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-a-32-plus-char-random-secret
BETTER_AUTH_URL=http://localhost:4000

# Bootstrap admin account. The admin portal is role-guarded and the create-user
# endpoint itself needs an admin session, so the first admin comes from here.
# Set both (or neither — half-configured refuses to boot). On every start the
# backend reconciles exactly one `admin` user for this email: creating it, or
# promoting / re-enabling / re-applying the password on an existing row. Rotate
# the password by changing it here and restarting. Min 8 chars.
ADMIN_EMAIL=admin@martyglobal.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# ADMIN_NAME=Marty Global Admin

# Amazon SES — outbound email (password resets, notifications).
#   • Leave the credentials blank in local dev — outbound email is logged and
#     skipped instead of sent (see config/ses.ts).
#   • To send for real, set an IAM key pair with the ses:SendEmail permission.
#   • SES_FROM_EMAIL (or its domain) must be a VERIFIED SES identity in
#     AWS_REGION, and the AWS account must be moved out of the SES sandbox to
#     deliver to addresses you haven't individually verified.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@martyglobal.com
SES_FROM_NAME=Marty Global
# SES_REPLY_TO_EMAIL=support@martyglobal.com
# SES_CONFIGURATION_SET=marty-default

# --- Cloudflare R2 — object storage (ID documents, mail scans, invoices) --
# Private buckets only. Files are never public: the backend mints short-TTL
# presigned URLs after an auth + ownership check (AGENTS.md, Security & PII).
# These are server secrets — none of them may ever be exposed to the browser.
#
#   • Leave all four blank in local dev — presigning is skipped and the UI shows
#     its pending/disabled states (see lib/storage.ts).
#   • Set all four or none: a half-filled block refuses to boot.
#
# Where to find them (Cloudflare dashboard → R2):
#   • R2_ACCOUNT_ID       — R2 Overview, right-hand sidebar ("Account ID").
#   • R2_BUCKET           — the bucket name you created. Keep "Public access"
#                           OFF; do not attach a public r2.dev domain.
#   • R2_ACCESS_KEY_ID /
#     R2_SECRET_ACCESS_KEY — R2 → Manage API tokens → Create API token, with
#                           "Object Read & Write" scoped to that one bucket.
#                           The secret is shown once at creation.
#
# ONE MORE STEP AFTER FILLING THESE IN — the bucket needs a CORS policy:
#
#     npm run storage:cors
#
# Uploads go browser -> R2 directly, so every PUT is preflighted. A bucket with
# no CORS rule answers that preflight with "403 CORS not configured for this
# bucket" and the upload never leaves the browser — no API log, no R2 log, just
# a network error on a screen that looks fully configured. Re-run it whenever
# FRONTEND_ORIGIN changes, and pass any extra origins as arguments.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
#
# REQUIRED if the bucket was created under an R2 jurisdiction — a EU bucket only
# answers on https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com, and the default
# hostname returns 403 AccessDenied for it on every call (list, put, presign),
# which reads exactly like an invalid key. Check this before regenerating a token.
# Also how you point at an S3-compatible local stand-in such as MinIO.
# R2_ENDPOINT=
# R2 ignores the region; the S3 protocol still requires one. Leave as 'auto'.
R2_REGION=auto
# Presigned link lifetime. These URLs are bearer tokens for PII — keep it short.
R2_PRESIGNED_URL_TTL_SECONDS=300

# --- USDT (TRC-20) via TronGrid ------------------------------------------
# We only ever WATCH the chain — no private key or seed phrase belongs in this
# file or anywhere else in the repo (AGENTS.md, Payments).
#
#   • TRON_NETWORK — 'nile' (testnet) for local dev and tests, 'mainnet' for
#     production. Mainnet refuses to boot without an address AND an API key.
#   • TRONGRID_API_KEY — free read-only key from trongrid.io → Dashboard →
#     API Keys. Optional on nile; the poller idles without one.
#   • TRON_DEPOSIT_ADDRESS — the PUBLIC receiving address ('T' + 33 chars) that
#     customers send USDT to. Create it in TronLink; never share its key.
#     Nile testnet funds: https://nileex.io/join/getJoinPage
TRON_NETWORK=nile
TRONGRID_API_KEY=
TRON_DEPOSIT_ADDRESS=
# Confirmations before a payment is credited. Tron is irreversible after ~19
# blocks (one super-representative round) at ~3s each.
TRON_MIN_CONFIRMATIONS=19
TRON_POLL_INTERVAL_SECONDS=30
# USD -> USDT rate as an integer over 1_000_000 (never a float). 1000000 is a
# 1:1 peg; raise it to add a spread (1010000 = +1%).
USDT_USD_RATE_MINOR=1000000
# How long a quoted USDT amount and its locked rate stay valid.
USDT_RATE_TTL_MINUTES=30

# --- Sentry — error monitoring -------------------------------------------
# Covers the API, the job workers, and the socket server (one process, one
# client). Leave blank in local dev and tests: without a DSN the SDK is never
# initialised, so nothing is sent and no network call is made.
#
# Get it from sentry.io -> your project -> Settings -> Client Keys (DSN). Use a
# SEPARATE project (and DSN) from the frontend's VITE_SENTRY_DSN so browser and
# server errors stay apart.
#
# PII is scrubbed in `beforeSend` (src/config/sentry.ts): request bodies are
# dropped outright and sensitive keys redacted, because this API handles
# identity documents, addresses, and tax IDs (AGENTS.md, Security & PII).
SENTRY_DSN=
# Tags every event. Defaults to NODE_ENV — set this only to distinguish
# deployments that share a NODE_ENV (e.g. 'staging' vs 'production').
SENTRY_ENVIRONMENT=
# Performance tracing sample rate, 0–1. Off by default: tracing is a paid quota
# and this API's health checks would burn it. 0.1 is a common starting point.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Live chat (Socket.io) -----------------------------------------------
# Sockets share this process and this port — there is nothing extra to run.
#
# How long an unanswered customer message waits before we email them. A staff
# reply inside the window cancels it (the job re-reads the thread when it fires).
SUPPORT_HANDOFF_DELAY_MINUTES=5
# Inbound socket messages per connection per minute — the socket twin of the
# REST chat limiter.
SUPPORT_SOCKET_MESSAGES_PER_MINUTE=60

# --- Anonymous visitor chat ----------------------------------------------
# The marketing site's chat bubble. A visitor's conversation is DELETED outright
# this many days after their last message — there is no soft delete and no
# recovery, which is deliberate for a pre-sales chat carrying no filing or
# payment (AGENTS.md requires asking before any hard delete; this was agreed).
GUEST_CHAT_RETENTION_DAYS=7
GUEST_CHAT_PURGE_INTERVAL_SECONDS=86400

# Cloudflare Turnstile — dash.cloudflare.com -> Turnstile -> Add site.
# Guards the ONE endpoint on this backend a bot can reach without a session
# (POST /v1/guest-chat/sessions). Leave blank and verification logs a warning
# and passes through, so local dev needs no Cloudflare account; production must
# set it. The matching PUBLIC site key goes in the frontend's .env as
# VITE_TURNSTILE_SITE_KEY — the two are issued together.
TURNSTILE_SECRET_KEY=

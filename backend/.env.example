NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://marty:marty@localhost:5433/marty
REDIS_URL=redis://localhost:6379

# Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-a-32-plus-char-random-secret
BETTER_AUTH_URL=http://localhost:4000

# Bootstrap admin account. The admin portal is role-guarded and the create-user
# endpoint itself needs an admin session, so the first admin comes from here.
# Set both (or neither — half-configured refuses to boot). On every start the
# backend reconciles exactly one `admin` user for this email: creating it, or
# promoting / re-enabling / re-applying the password on an existing row. Rotate
# the password by changing it here and restarting. Min 8 chars.
ADMIN_EMAIL=admin@martyglobal.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# ADMIN_NAME=Marty Global Admin

# Amazon SES — outbound email (password resets, notifications).
#   • Leave the credentials blank in local dev — outbound email is logged and
#     skipped instead of sent (see config/ses.ts).
#   • To send for real, set an IAM key pair with the ses:SendEmail permission.
#   • SES_FROM_EMAIL (or its domain) must be a VERIFIED SES identity in
#     AWS_REGION, and the AWS account must be moved out of the SES sandbox to
#     deliver to addresses you haven't individually verified.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@martyglobal.com
SES_FROM_NAME=Marty Global
# SES_REPLY_TO_EMAIL=support@martyglobal.com
# SES_CONFIGURATION_SET=marty-default

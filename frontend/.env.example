VITE_API_URL=http://localhost:4000/v1
VITE_AUTH_URL=http://localhost:4000
# Public site origin — used for canonical + Open Graph URLs on marketing pages.
VITE_SITE_URL=http://localhost:5173
# Cloudflare Turnstile site key — the PUBLIC half of the pair (the secret lives
# in the backend's .env). Guards the marketing site's anonymous chat bubble.
# Blank renders no challenge, matching a backend with no secret configured.
VITE_TURNSTILE_SITE_KEY=

# Sentry — browser error monitoring. Leave blank in local dev: without a DSN the
# SDK is never initialised, so nothing is sent and no network call is made.
# A browser DSN is public by design (it only permits writing events) — it is the
# one Sentry value that may ship to the client, which is why it is a VITE_ var.
# The backend has its own separate DSN in backend/.env.
#
# PII is scrubbed in `beforeSend` (src/lib/sentry.ts) and Session Replay is
# deliberately NOT enabled — these screens show identity documents and scanned
# mail (AGENTS.md, Security & PII).
VITE_SENTRY_DSN=
# Tags events so staging errors are never mistaken for production. Defaults to
# Vite's mode ('development' / 'production').
VITE_SENTRY_ENVIRONMENT=
# Ties an event to the deploy that produced it — set in CI to the commit SHA.
VITE_SENTRY_RELEASE=
